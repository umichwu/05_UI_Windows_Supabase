              "value": "={{ $json.user_id }}"
            },
            {
              "name": "metadata",
              "value": "={{ JSON.stringify({\n  type: 'care_message',\n  rule_id: $json.rule_id,\n  emotion_trigger: $json.emotion_stats,\n  generated_at: new Date().toISOString()\n}) }}"
            }
          ]
        }
      },
