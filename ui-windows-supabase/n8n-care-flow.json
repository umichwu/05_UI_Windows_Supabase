      "id": "7",
      "name": "Should Send External Notification?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "jsCode": "// Simulate LINE/WeChat notification\nconst eventData = $input.first().json;\nconst action = eventData.action || {};\nconst channel = action.notify_channel;\n\n// In a real implementation, you would:\n// - Use LINE Messaging API for LINE notifications\n// - Use WeChat Work API for WeChat notifications\n// - Use FCM/APNS for mobile push notifications\n\nconsole.log(`📱 External notification sent via ${channel}:`);\nconsole.log(`User: ${eventData.user_id}`);\nconsole.log(`Message: ${eventData.care_message}`);\nconsole.log(`Severity: ${action.severity || 'info'}`);\n\n// Create outbox event for external notification tracking\nreturn [{\n  json: {\n    user_id: eventData.user_id,\n    event_type: 'care.notify',\n    status: 'pending',\n    payload: {\n      original_event_id: eventData.id,\n      channel: channel,\n      message: eventData.care_message,\n      severity: action.severity || 'info',\n      timestamp: new Date().toISOString()\n    }\n  }\n}];"
      },
