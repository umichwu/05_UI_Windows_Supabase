      "id": "3",
      "name": "Has Care Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process each care event\nconst events = $input.all();\nconst processedEvents = [];\n\nfor (const event of events) {\n  const eventData = event.json;\n  const payload = eventData.payload;\n  \n  // Generate caring message based on detected emotions\n  let careMessage = \"\";\n  \n  if (payload.target_emotions.includes('sad')) {\n    careMessage = `Hi there! I noticed you might be feeling a bit down lately. Your wellbeing is important to me. Would you like to talk about what's on your mind? 💙`;\n  } else if (payload.target_emotions.includes('angry')) {\n    careMessage = `I can sense some frustration in your recent interactions. Sometimes it helps to take a deep breath and share what's bothering you. I'm here to listen. 🤗`;\n  } else if (payload.target_emotions.includes('fear')) {\n    careMessage = `I noticed some signs of anxiety or worry. Remember that it's okay to feel this way, and you don't have to face it alone. Take your time, and know that I'm here for you. 🌟`;\n  } else {\n    careMessage = `I've been monitoring your emotional wellbeing and wanted to check in with you. How are you feeling today? Remember, I'm always here if you need support. ❤️`;\n  }\n  \n  processedEvents.push({\n    id: eventData.id,\n    user_id: eventData.user_id,\n    conversation_id: eventData.conversation_id,\n    rule_id: payload.rule_id,\n    care_message: careMessage,\n    emotion_stats: {\n      ratio: payload.ratio,\n      hit: payload.hit,\n      total: payload.total,\n      window_sec: payload.window_sec,\n      target_emotions: payload.target_emotions\n    },\n    action: payload.action || {}\n  });\n}\n\nreturn processedEvents.map(event => ({ json: event }));"
      },
      "id": "4",
      "name": "Generate Care Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220]
